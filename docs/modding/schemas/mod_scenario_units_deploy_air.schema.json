{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "mod_scenario_units_deploy_air.schema.json",
    "title": "Mod Scenario – Air Wing Deployments",
    "description": "Fragment file: places air wing stacks at scenario start.",
    "type": "object",
    "required": ["initialAirWings"],
    "properties": {
        "initialAirWings": {
            "type": "array",
            "items": { "$ref": "#/definitions/ScenarioAirWingStackDefinition" },
            "minItems": 1
        }
    },
    "additionalProperties": false,
    "definitions": {
        "ScenarioStackUnitDefinition": {
            "type": "object",
            "required": ["unitTypeId"],
            "properties": {
                "unitTypeId": { "type": "string" },
                "unitDefIndex": { "type": "integer", "minimum": -1, "default": -1 },
                "count": { "type": "integer", "minimum": 1, "default": 1 },
                "currentHp": { "type": "number", "minimum": 0, "default": -1 }
            },
            "additionalProperties": false
        },
        "ScenarioAirWingStackDefinition": {
            "type": "object",
            "required": ["ownerISO3", "provinceId", "units"],
            "properties": {
                "ownerISO3": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "provinceId": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Province ID of the airfield province where the wing is based. The province needs an airbase at scenario start or the wing is skipped."
                },
                "missionType": {
                    "type": "string",
                    "enum": ["None","AirSuperiority","CloseAirSupport","StrategicBombing","Reconnaissance","NavalStrike","cas","interception","strategic_bombing","naval_strike","patrol","standby"],
                    "description": "Default mission assigned to the wing at spawn. The enum names are canonical; the snake_case spellings are accepted aliases (cas = CloseAirSupport, interception/patrol = AirSuperiority, standby = None)."
                },
                "readiness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": -1,
                    "description": "Starting readiness in [0, 1] (scaled to the game's 0-100). -1 = full readiness."
                },
                "morale": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": -1,
                    "description": "Starting morale in [0, 1] of the wing's maximum. -1 = full morale."
                },
                "units": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ScenarioStackUnitDefinition" },
                    "minItems": 1
                }
            },
            "additionalProperties": false
        }
    }
}

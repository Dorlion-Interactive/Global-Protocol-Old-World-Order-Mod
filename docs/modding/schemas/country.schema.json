{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "country.schema.json",
    "title": "Country",
    "description": "Full country definition for Global Protocol. One JSON file per country.",
    "type": "object",
    "required": [
        "iso3",
        "name",
        "government",
        "economy",
        "military",
        "geography"
    ],
    "properties": {
        "iso3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 3166-1 alpha-3 code"
        },
        "name": {
            "type": "string"
        },
        "map_color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Map display color (hex)"
        },
        "map_color_vibrant": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Vibrant palette variant of map_color (generated by country_color_variants.py)"
        },
        "map_color_gloomy": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Gloomy palette variant of map_color (generated by country_color_variants.py)"
        },
        "flag_file": {
            "type": "string",
            "description": "Relative path to flag image"
        },
        "government": {
            "type": "object",
            "required": [
                "type",
                "subtype",
                "ideology",
                "political_spectrum"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "democracy",
                        "authoritarian",
                        "hybrid",
                        "monarchy",
                        "theocracy",
                        "military_junta",
                        "one_party",
                        "communist_state",
                        "transitional",
                        "unknown"
                    ]
                },
                "subtype": {
                    "type": "string",
                    "enum": [
                        "None",
                        "LiberalDemocracy",
                        "IlliberalDemocracy",
                        "ParliamentaryMonarchy",
                        "AbsoluteMonarchy",
                        "MilitaryDictatorship",
                        "Stratocracy",
                        "Theocracy",
                        "OnePartyState",
                        "Despotic",
                        "Anarchy",
                        "Transitional",
                        "SocialistRepublic",
                        "FederalRepublic"
                    ]
                },
                "leader_name": {
                    "type": "string"
                },
                "leader_title": {
                    "type": "string"
                },
                "ideology": {
                    "type": "string",
                    "enum": [
                        "liberal",
                        "conservative",
                        "socialist",
                        "nationalist",
                        "islamist",
                        "communist",
                        "fascist",
                        "libertarian",
                        "mixed",
                        "unknown"
                    ]
                },
                "political_spectrum": {
                    "type": "object",
                    "properties": {
                        "economic_stance": {
                            "type": "number",
                            "minimum": -1,
                            "maximum": 1
                        },
                        "social_stance": {
                            "type": "number",
                            "minimum": -1,
                            "maximum": 1
                        }
                    }
                },
                "stability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "corruption": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        },
        "economy": {
            "type": "object",
            "properties": {
                "gdp_usd": {
                    "type": "number",
                    "description": "GDP in current USD"
                },
                "gdp_per_capita": {
                    "type": "number"
                },
                "gdp_growth_rate": {
                    "type": "number"
                },
                "inflation_rate": {
                    "type": "number"
                },
                "debt_to_gdp_ratio": {
                    "type": "number"
                },
                "unemployment_rate": {
                    "type": "number"
                },
                "hdi": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "primary_resources": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "None",
                            "Oil", "NaturalGas", "Coal", "Uranium", "RefinedPetroleum",
                            "Iron", "Copper", "Bauxite", "Aluminum", "Steel", "Gold", "Silver", "Tin",
                            "Lithium", "Cobalt", "Nickel", "RareEarths", "Helium",
                            "Graphite", "Manganese", "Chromium", "Tungsten",
                            "Wheat", "Rice", "Corn", "Soybeans", "Livestock", "Fish",
                            "Coffee", "Cocoa", "Sugar", "Cotton",
                            "Timber", "Rubber", "PalmOil", "Wool",
                            "Phosphate", "Potash", "Electronics", "Semiconductors",
                            "Batteries", "SolarPanels", "WindTurbines", "Automobiles",
                            "Aircraft", "Ships", "Machinery", "Chemicals", "Plastics",
                            "Fertilizer", "Pharmaceuticals", "Textiles",
                            "Services", "Financials"
                        ]
                    }
                },
                "currency_name": {
                    "type": "string"
                },
                "exports_usd": {
                    "type": "number",
                    "description": "Total exports in USD"
                },
                "imports_usd": {
                    "type": "number",
                    "description": "Total imports in USD"
                },
                "foreign_reserves_usd": {
                    "type": "number",
                    "description": "Foreign exchange reserves in USD"
                },
                "avg_tariff_rate": {
                    "type": "number",
                    "description": "Weighted mean applied tariff %"
                },
                "gini_coefficient": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Income inequality (0=equal, 100=unequal)"
                },
                "starting_treasury": {
                    "type": "number",
                    "description": "Starting treasury in game USD"
                },
                "literacy_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "trade_balance_pct_gdp": {
                    "type": "number"
                },
                "exports_top5": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Top 5 export partners by ISO3"
                },
                "imports_top5": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Top 5 import partners by ISO3"
                },
                "resource_production": {
                    "type": "object",
                    "description": "Resource production weights (resource_id → weight 0.1-10.0)",
                    "additionalProperties": { "type": "number" }
                }
            }
        },
        "budget": {
            "type": "object",
            "description": "Government budget allocation percentages",
            "properties": {
                "tax_rate": { "type": "number", "minimum": 0, "maximum": 100 },
                "military_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "research_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "infra_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "social_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "reserve_pct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
        },
        "trade": {
            "type": "object",
            "description": "Trade agreements and bilateral tariff overrides",
            "properties": {
                "agreements": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "type": { "type": "string" },
                            "tariff_modifier": { "type": "number" }
                        }
                    }
                },
                "bilateral_tariffs": {
                    "description": "Bilateral tariff overrides. Legacy map format and entry-array format are both accepted.",
                    "oneOf": [
                        {
                            "type": "object",
                            "description": "Legacy format: ISO3 → tariff rate overrides",
                            "additionalProperties": { "type": "number" }
                        },
                        {
                            "type": "array",
                            "description": "Preferred format for Unity importer",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "target_iso3": {
                                        "type": "string",
                                        "pattern": "^[A-Z]{3}$"
                                    },
                                    "rate": { "type": "number" }
                                },
                                "required": ["target_iso3", "rate"],
                                "additionalProperties": false
                            }
                        }
                    ]
                }
            }
        },
        "demographics": {
            "type": "object",
            "description": "Social development indicators",
            "properties": {
                "life_expectancy": { "type": "number" },
                "education_index": { "type": "number", "minimum": 0, "maximum": 1 },
                "urbanization_rate": { "type": "number", "minimum": 0, "maximum": 100 },
                "fertility_rate": { "type": "number", "minimum": 0.5, "maximum": 8.0, "description": "Total fertility rate (births per woman)" },
                "net_migration_rate": { "type": "number", "description": "Annual net migration rate per 1000 population" },
                "health_expenditure_pct_gdp": { "type": "number", "minimum": 0, "maximum": 30, "description": "Health expenditure as % of GDP" },
                "dominant_religion": { "type": "string", "description": "Largest religion by population share (drives kinship relations/AI restraint)" },
                "dominant_ethnicity": { "type": "string", "description": "Largest ethnic group by population share (drives kinship relations/AI restraint)" },
                "primary_culture": { "type": "string", "description": "Primary cultural identity of the country" },
                "ethnic_homogeneity": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 = highly diverse, 1 = ethnically homogeneous" }
            }
        },
        "military": {
            "type": "object",
            "properties": {
                "active_personnel": {
                    "type": "integer"
                },
                "reserve_personnel": {
                    "type": "integer"
                },
                "defense_budget_usd": {
                    "type": "number"
                },
                "equipment": {
                    "type": "object",
                    "properties": {
                        "tanks": {
                            "type": "integer"
                        },
                        "aircraft": {
                            "type": "integer"
                        },
                        "ships": {
                            "type": "integer"
                        },
                        "submarines": {
                            "type": "integer"
                        },
                        "helicopters": {
                            "type": "integer"
                        },
                        "apcs": {
                            "type": "integer"
                        },
                        "artillery": {
                            "type": "integer"
                        }
                    }
                },
                "nuclear": {
                    "type": "object",
                    "properties": {
                        "warheads": {
                            "type": "integer",
                            "default": 0
                        },
                        "has_icbm": {
                            "type": "boolean",
                            "default": false
                        },
                        "has_slbm": {
                            "type": "boolean",
                            "default": false
                        },
                        "has_missile_defense": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                },
                "conventional_missiles": {
                    "type": "object",
                    "description": "Starting conventional missile stocks seeded at game start. cruise_missile_count maps to the 'cruise_missile' missile type; tactical_ballistic_missile_count maps to 'tactical_ballistic_missile'.",
                    "properties": {
                        "cruise_missile_count": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0
                        },
                        "tactical_ballistic_missile_count": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0
                        }
                    }
                }
            }
        },
        "geography": {
            "type": "object",
            "properties": {
                "capital": {
                    "type": "string"
                },
                "area_km2": {
                    "type": "number"
                },
                "population": {
                    "type": "integer"
                },
                "continent": {
                    "type": "string",
                    "enum": [
                        "Unknown",
                        "Africa",
                        "Americas",
                        "Asia",
                        "Europe",
                        "Oceania",
                        "Antarctica"
                    ]
                },
                "region": {
                    "type": "string",
                    "enum": [
                        "Unknown",
                        "NorthernAfrica",
                        "SubSaharanAfrica",
                        "LatinAmericaCaribbean",
                        "NorthernAmerica",
                        "CentralAsia",
                        "EastAsia",
                        "SouthAsia",
                        "SoutheastAsia",
                        "WesternAsia",
                        "EasternEurope",
                        "NorthernEurope",
                        "SouthernEurope",
                        "WesternEurope",
                        "AustraliaNewZealand",
                        "Melanesia",
                        "Micronesia",
                        "Polynesia"
                    ]
                },
                "coastline_km": {
                    "type": "number"
                },
                "neighbors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sea_neighbors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Countries reachable across a shared coastal sea zone but without a land border"
                },
                "province_count": {
                    "type": "integer"
                }
            }
        },
        "diplomacy": {
            "type": "object",
            "properties": {
                "alliances": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "partner_iso3": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string",
                                "enum": [
                                    "Military",
                                    "CollectiveDefense",
                                    "Economic",
                                    "DefensePact",
                                    "TradeAgreement",
                                    "Political",
                                    "InternationalOrg",
                                    "Unknown"
                                ]
                            }
                        }
                    }
                },
                "rivals": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "un_member": {
                    "type": "boolean"
                },
                "un_security_council": {
                    "type": "boolean"
                }
            }
        },
        "ai_personality": {
            "type": "object",
            "description": "AI behavior profile for this country",
            "properties": {
                "ai_type": {
                    "type": "string",
                    "enum": [
                        "balanced",
                        "militarist",
                        "expansionist",
                        "diplomat",
                        "trader",
                        "isolationist",
                        "opportunist",
                        "defender"
                    ]
                },
                "aggression": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "diplomacy_focus": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "economic_priority": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "military_investment": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "tech_investment": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "alliance_loyalty": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "nuclear_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 1.0
                },
                "isolationism": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 0.5
                },
                "expansion_desire": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2.0,
                    "default": 0.5
                },
                "grand_strategy_primary": {
                    "type": "string",
                    "enum": [
                        "regional_hegemon",
                        "economic_superpower",
                        "nuclear_deterrent",
                        "alliance_leader",
                        "territorial_revisionist",
                        "ideological_crusader",
                        "fortress_nation",
                        "tech_pioneer",
                        "military_dominance",
                        "diplomatic_leader",
                        "fortress_defense"
                    ]
                },
                "grand_strategy_secondary": {
                    "type": "string"
                }
            }
        },
        "intelligence": {
            "type": "object",
            "description": "National intelligence agency data. Null/absent means no established agency.",
            "properties": {
                "agency_name": {
                    "type": "string",
                    "description": "Full name of the intelligence agency (e.g. Central Intelligence Agency)"
                },
                "agency_acronym": {
                    "type": "string",
                    "description": "Short acronym (e.g. CIA, MI6, FSB, MIT, Mossad)"
                },
                "founded_year": {
                    "type": "integer",
                    "description": "Year the agency was established"
                },
                "specialization": {
                    "type": "string",
                    "enum": ["signals", "humint", "cyber", "counterintel", "balanced"],
                    "description": "Primary intelligence specialization"
                },
                "five_eyes_member": {
                    "type": "boolean",
                    "default": false,
                    "description": "Member of Five Eyes intelligence alliance (USA, GBR, CAN, AUS, NZL)"
                }
            },
            "required": ["agency_name", "agency_acronym", "founded_year", "specialization"]
        },
        "difficulty_stars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Gameplay difficulty rating (1=Beginner, 2=Easy, 3=Normal, 4=Hard, 5=Expert). Computed from GDP, military, stability, and geopolitical factors."
        },
        "difficulty_notes": {
            "type": "string",
            "description": "Short human-readable explanation of why this difficulty was assigned (e.g. 'Superpower with massive GDP and nuclear arsenal')"
        },
        "recognition_status": {
            "type": "string",
            "enum": ["recognized", "partially_recognized", "unrecognized", "dependent_territory"],
            "default": "recognized",
            "description": "International recognition status. Missing = fully recognized. Used for diplomacy events, UN mechanics, and UI labels."
        },
        "claimed_by": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO3 of the state that claims sovereignty over this territory (e.g. CYP claims CYN, SRB claims XKX, CHN claims TWN)."
        }
    }
}